#!/usr/bin/env bash
# ==============================================================================
# ravn-webapp-handler-zoom — Zoom Web Meeting Protocol Handler
# ==============================================================================

set -euo pipefail

url="${1:-}"
web_url="https://app.zoom.us/wc/home"

if [[ "$url" =~ ^zoom(mtg|us):// ]]; then
  confno=$(printf '%s\n' "$url" | sed -n 's/.*[?&]confno=\([^&]*\).*/\1/p')
  if [[ -n "$confno" ]]; then
    pwd=$(printf '%s\n' "$url" | sed -n 's/.*[?&]pwd=\([^&]*\).*/\1/p')
    if [[ -n "$pwd" ]]; then
      web_url="https://app.zoom.us/wc/join/$confno?pwd=$pwd"
    else
      web_url="https://app.zoom.us/wc/join/$confno"
    fi
  fi
fi

exec ravn-launch-webapp "$web_url"
